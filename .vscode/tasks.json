{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Vite App",
			"type": "shell",
			"command": "vite",
			"isBackground": true,
			"problemMatcher": [
				"$vite"
			],
			"group": "build"
		},
		{
			"label": "Run Vite App (npx)",
			"type": "shell",
			"command": "npx",
			"args": [
				"vite",
				"--host",
				"0.0.0.0",
				"--port",
				"5173"
			],
			"isBackground": true,
			"group": "build"
		}
	]
}